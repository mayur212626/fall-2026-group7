ticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="1090" height="65" as="geometry" /></mxCell><mxCell id="n7" value="three training conditions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 8;fontSize=13;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="185" y="335" width="1120" height="130" as="geometry" /></mxCell><mxCell id="n8" value="Real images only&lt;br&gt;(control)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="370" width="340" height="80" as="geometry" /></mxCell><mxCell id="n9" value="Real + conventional aug&lt;br&gt;RandAugment · Mixup · CutMix" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="370" width="340" height="80" as="geometry" /></mxCell><mxCell id="n10" value="Real + synthetic&lt;br&gt;5 generators · 1:1 · 2:1 · 5:1&lt;br&gt;resized to 32×32 first" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="950" y="370" width="340" height="80" as="geometry" /></mxCell><mxCell id="n11" value="ResNet-50&lt;br&gt;(CNN)&lt;br&gt;pretrained · random init" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="505" width="250" height="75" as="geometry" /></mxCell><mxCell id="n12" value="ConvNeXt-Tiny&lt;br&gt;(CNN)&lt;br&gt;pretrained · random init" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="505" width="250" height="75" as="geometry" /></mxCell><mxCell id="n13" value="ViT-B/16&lt;br&gt;(Transformer)&lt;br&gt;pretrained · random init" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="505" width="250" height="75" as="geometry" /></mxCell><mxCell id="n14" value="Swin-T&lt;br&gt;(Transformer)&lt;br&gt;pretrained · random init" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1040" y="505" width="250" height="75" as="geometry" /></mxCell><mxCell id="n15" value="Top-1 accuracy · macro-F1 · balanced accuracy · per-class recall · rare-class recall&lt;br&gt;3 seeds per condition in Stage 1, 5 later · 95% bootstrap CI · paired change from each control" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=4;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="620" width="1090" height="85" as="geometry" /></mxCell><mxCell id="n16" value="What we are looking for: does a better generator (lower FID) actually give higher accuracy (RQ1), and do the two CNNs react differently from the two Transformers (RQ2)? A drop in accuracy is a valid result and gets reported." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="735" width="1090" height="60" as="geometry" /></mxCell><mx