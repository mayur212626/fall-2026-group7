="n7" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n24" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.628;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n25" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.885;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n26" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.115;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n27" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.372;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n28" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.628;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n29" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.885;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n30" value="&lt;b&gt;Bold border = part of Stage 1:&lt;/b&gt; Tier A (CIFAR-100) · ResNet-50 and ViT-B/16 · real-only, RandAugment and the two Stable Diffusion generators · ratio 1:1." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#000000;"><mxGeometry x="200" y="800" width="1090" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="3. Object detection" id="det"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" page="1" pageWidth="1340" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" style="" /><mxCell id="1" parent="0" style="" /><mxCell id="n2" value="train2017&lt;br&gt;training pool" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n3" value="train2017&lt;br&gt;tuning pool (method choices only)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n4" value="val2017&lt;br&gt;HELD OUT - final test only" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="950" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n5" value="Fixed low-data subset&lt;br&gt;drawn only from the training pool" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="215" width="340" height="80" as="geometry" /></mxCell><mxCell id="n6" value="Conventional aug that&lt;br&gt;moves the boxes correctly" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="335" width="340" height="85" as="geometry" /></mxCell><mxCell id="n7" value="Make fake images&lt;br&gt;SD prompts · SD + LoRA" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="335" width="340" height="85" as="geometry" /></mxCell><mxCell id="n8" value="Annotation audit - are the boxes still right?&lt;br&gt;object moved · added · removed · only partly visible&lt;br&gt;→ correct the box, or throw the image away · every rejection recorded" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="460" width="715" height="95" as="geometry" /></mxCell><mxCell id="n9" value="Train detector - same backbone, resolution and training budget · 5 seeds" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="595" width="715" height="75" as="geometry" /></mxCell><mxCell id="n10" value="AP on val2017 (IoU 0.50-0.95) · AP50 · AP75 · AP by object size · per-category AP" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="710" width="715" height="80" as="geometry" /></mxCell><mxCell id="n11" value="The whole point of this diagram is the annotation-audit box. A generated image can move or delete an object, which silently makes the original box wrong - training on that is worse than not augmenting at all. The audit rule is fixed on development data before the real runs." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="825" width="1090" height="70" as="geometry" /></mxCell><mxCell id="n12" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.14;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n18" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;dashed=1;dashPattern=6 6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_dashed" value="Dashed arrow: evaluation only, not used for training." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#000000;"><mxGeometry x="200" y="903" width="700" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="4. Image captioning" id="cap"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" page="1" pageWidth="1340" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" style="" /><mxCell id="1" parent="0" style="" /><mxCell id="n2" value="train2017 images&lt;br&gt;+ human captions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n3" value="train2017&lt;br&gt;tuning pool (method choices only)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n4" value="val2017&lt;br&gt;HELD OUT - final test only" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="950" y="95" width="340" height="80" as="geometry" /></mxCell><mxCell id="n5" value="Fixed low-data subset&lt;br&gt;all captions of an image stay together" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="215" width="340" height="80" as="geometry" /></mxCell><mxCell id="n6" value="Conventional aug that&lt;br&gt;keeps the caption true" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="335" width="340" height="85" as="geometry" /></mxCell><mxCell id="n7" value="Make fake image&lt;br&gt;+ its caption" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="335" width="340" height="85" as="geometry" /></mxCell><mxCell id="n8" value="Caption check - is the caption still true of the image?&lt;br&gt;objects · attributes · counts · relationships&lt;br&gt;→ rewrite the caption, or throw the image away" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="460" width="715" height="95" as="geometry" /></mxCell><mxCell id="n9" value="Train captioner - same visual and text parts, same decoding settings · 5 seeds" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="595" width="715" height="75" as="geometry" /></mxCell><mxCell id="n10" value="CIDEr on val2017 · SPICE · BLEU-4 · METEOR · ROUGE-L&lt;br&gt;+ blinded human check of whether the caption matches the image" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="710" width="715" height="80" as="geometry" /></mxCell><mxCell id="n11" value="Same risk as detection, different label: the fake image changes a count, a colour or an object, so the caption becomes false. CIDEr and BLEU do not catch that, which is why a blinded human sample review sits next to the automatic scores." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="825" width="1090" height="70" as="geometry" /></mxCell><mxCell id="n12" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n14" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.14;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n18" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;dashed=1;dashPattern=6 6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_dashed" value="Dashed arrow: evaluation only, not used for training." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#000000;"><mxGeometry x="200" y="903" width="700" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="5. Pretrained features &amp; hybrid model" id="hyb"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" page="1" pageWidth="1240" pageHeight="940" math="0" shadow="0"><root><mxCell id="0" style="" /><mxCell id="1" parent="0" style="" /><mxCell id="n2" value="Input image" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="95" width="340" height="65" as="geometry" /></mxCell><mxCell id="n3" value="Task model&lt;br&gt;(trainable)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="340" height="85" as="geometry" /></mxCell><mxCell id="n4" value="Frozen pretrained encoder&lt;br&gt;(auxiliary features)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="340" height="85" as="geometry" /></mxCell><mxCell id="n5" value="Combine the two feature sets&lt;br&gt;fusion rule written down" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="340" height="80" as="geometry" /></mxCell><mxCell id="n6" value="Prediction head" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="340" height="65" as="geometry" /></mxCell><mxCell id="n7" value="four conditions, to separate the two effects" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 8;fontSize=13;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="540" width="1120" height="140" as="geometry" /></mxCell><mxCell id="n8" value="1. Base model&lt;br&gt;+ real" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="575" width="250" height="85" as="geometry" /></mxCell><mxCell id="n9" value="2. Base model&lt;br&gt;+ real &amp; synthetic" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="575" width="250" height="85" as="geometry" /></mxCell><mxCell id="n10" value="3. Hybrid&lt;br&gt;+ real" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="575" width="250" height="85" as="geometry" /></mxCell><mxCell id="n11" value="4. Hybrid&lt;br&gt;+ real &amp; synthetic" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="940" y="575" width="250" height="85" as="geometry" /></mxCell><mxCell id="n12" value="Plus a capacity-matched control: same-size head, no extra features&lt;br&gt;so a gain cannot be explained by extra parameters alone · report added params, training time, inference time, memory" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="705" width="1090" height="85" as="geometry" /></mxCell><mxCell id="n13" value="Conditions 1 vs 2 measure what the synthetic images are worth. Conditions 1 vs 3 measure what the extra pretrained features are worth. Condition 4 shows whether the two help together or overlap. Only information available at prediction time goes into the model at test time." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="815" width="1090" height="70" as="geometry" /></mxCell><mxCell id="n14" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.34;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n15" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.66;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.34;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n17" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.66;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n18" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n20" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>