* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.tex text eol=lf
*.bib text eol=lf

# Raster images and video go through Git LFS. Results figures are SVG or PDF and stay in Git.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
