{
  "dataset": "flowers102",
  "image_size": 224,
  "batch_size": 128,
  "evaluations": 20,
  "warmup_fraction": 0.05,
  "grad_clip": 1.0,
  "label_smoothing": 0.1,
  "steps": {
    "2": 600,
    "5": 600,
    "10": 800
  },
  "models": {
    "resnet50": {"optimizer": "adamw", "lr": 0.001, "weight_decay": 0.05},
    "vit_b_16": {"optimizer": "adamw", "lr": 0.0002, "weight_decay": 0.05}
  }
}
