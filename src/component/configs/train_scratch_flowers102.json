{
  "dataset": "flowers102",
  "image_size": 224,
  "batch_size": 128,
  "evaluations": 20,
  "warmup_fraction": 0.05,
  "grad_clip": 1.0,
  "label_smoothing": 0.1,
  "steps": {
    "2": 2000,
    "5": 2000,
    "10": 3000
  },
  "models": {
    "resnet50": {"optimizer": "sgd", "lr": 0.3, "momentum": 0.9, "weight_decay": 0.0005},
    "vit_b_16": {"optimizer": "adamw", "lr": 0.0001, "weight_decay": 0.05}
  }
}
