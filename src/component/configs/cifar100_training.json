{
  "stage": "development",
  "image_size": 224,
  "normalization_mean": [0.5, 0.5, 0.5],
  "normalization_std": [0.5, 0.5, 0.5],
  "batch_size": 8,
  "workers": 2,
  "steps": 1000,
  "validation_interval": 100,
  "warmup_steps": 50,
  "gradient_clip": 1.0,
  "randaugment": {"num_ops": 2, "magnitude": 9},
  "mixup_alpha": 0.2,
  "cutmix_alpha": 1.0,
  "models": {
    "resnet50": {"optimizer": "sgd", "lr": 0.01, "momentum": 0.9, "weight_decay": 0.0001},
    "convnext_tiny": {"optimizer": "adamw", "lr": 0.0005, "weight_decay": 0.05},
    "vit_b_16": {"optimizer": "adamw", "lr": 0.0003, "weight_decay": 0.05},
    "swin_t": {"optimizer": "adamw", "lr": 0.0005, "weight_decay": 0.05}
  }
}
